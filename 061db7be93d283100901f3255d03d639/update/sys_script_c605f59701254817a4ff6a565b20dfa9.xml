        <script><![CDATA[(function(current, previous) {
    var entitlementId = current.getValue('entitlement');
    if (!entitlementId) {
        gs.addErrorMessage('An entitlement must be selected.');
        current.setAbortAction(true);
        return;
    }
    var ent = new GlideRecord('x_1970512_softwa_0_entitlement');
    if (ent.get(entitlementId)) {
        var available = parseInt(ent.getValue('available_rights'), 10);
        if (available <= 0) {
            gs.addErrorMessage('No remaining license rights available. The selected entitlement has no available license rights for allocation.');
            current.setAbortAction(true);
        }
    }
})(current, previous);
]]></script>
